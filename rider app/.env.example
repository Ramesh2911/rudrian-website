# Base URL of the Logistics ERP API.
# Android emulator reaches the host machine through 10.0.2.2.
# iOS simulator / a real device on the same LAN must use your machine's LAN IP,
# e.g. http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1

# Socket.IO endpoint for live task assignment updates (same host rules apply).
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:4000
