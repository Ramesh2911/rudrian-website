{
  "expo": {
    "name": "Rudrian Logistics Rider",
    "slug": "rudrianlogistics-rider",
    "owner": "ramesh0329",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rudrianlogistics.rider"
    },
    "android": {
      "package": "com.rudrianlogistics.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "5ca94864-c972-4246-a22f-1f2cee6a651c"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/splash-square.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rudrian Logistics Rider to scan parcel barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rudrian Logistics Rider to capture photos for Proof of Delivery."
        }
      ]
    ]
  }
}
