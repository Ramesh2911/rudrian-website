{
  "name": "logistics-erp-monorepo",
  "private": true,
  "workspaces": [
    "server",
    "Main ERP",
    "Website"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,erp,web -c blue,green,magenta \"npm run dev -w server\" \"npm run dev -w erp-web\" \"npm run dev -w website\"",
    "dev:server": "npm run dev -w server",
    "dev:erp": "npm run dev -w erp-web",
    "dev:web": "npm run dev -w website",
    "dev:rider": "npm --prefix \"rider app\" run start",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
