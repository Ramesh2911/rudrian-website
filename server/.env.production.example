# Production env template for the API server.
# Copied to server/.env by deploy/deploy.sh on first run.
# deploy.sh auto-replaces CHANGE_ME in DATABASE_URL with the MySQL password
# generated in deploy/.env — but JWT secrets MUST be changed manually.

PORT=4000
NODE_ENV=production

# DB runs on the same VPS (Docker, bound to 127.0.0.1:3306)
DATABASE_URL=mysql://logistics:CHANGE_ME@127.0.0.1:3306/logistics_erp
REDIS_URL=redis://127.0.0.1:6379

# Generate strong values:  openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Browser origins allowed by CORS + sockets
CORS_ORIGINS=https://rudrianlogistics.com,https://www.rudrianlogistics.com,https://admin.rudrianlogistics.com
APP_URL=https://rudrianlogistics.com
ERP_URL=https://admin.rudrianlogistics.com

# WhatsApp Cloud API (optional — falls back to SMS log)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# MSG91 SMS/OTP (optional — OTP logged to console)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Razorpay (optional — falls back to COD/mock pay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

UPLOAD_DIR=./uploads
